# Local development database. Keep this separate from any production database.
MONGODB_URI=mongodb://127.0.0.1:27017/hospital_management_sprint1
PORT=5000

# Replace this value with a long random secret before local use.
JWT_SECRET=replace-this-with-a-long-random-local-secret

# Frontend development origin
CLIENT_ORIGIN=http://localhost:5173

# Hospital local-time handling for appointment slots
HOSPITAL_TIME_ZONE=Asia/Kolkata

# Optional demo account overrides. The defaults are printed by `npm run seed`.
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=Admin@123
DEMO_RECEPTIONIST_EMAIL=reception@example.com
DEMO_RECEPTIONIST_PASSWORD=Recep@123
DEMO_DOCTOR_EMAIL=doctor@example.com
DEMO_DOCTOR_PASSWORD=Doctor@123
DEMO_PATIENT_EMAIL=aarav.demo@example.com
DEMO_PATIENT_PASSWORD=Pat@1234
